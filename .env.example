# Copy to .env for local development. Never commit .env. Generate secrets with: openssl rand -hex 24
NODE_ENV=development
POSTGRES_ADMIN_USER=core_admin
POSTGRES_ADMIN_PASSWORD=
CORE_APP_DB_PASSWORD=
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
API_DOCS_ENABLED=true
# Optional: OTLP collector endpoint, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Host ports (change if already in use on your machine)
API_HOST_PORT=3000
WEB_HOST_PORT=8080
# Identity (local test OIDC server). In Azure these point at Microsoft Entra ID.
PUBLIC_APP_ORIGIN=http://localhost:8080
OIDC_ISSUER_URL=http://oidc.localhost:8180/default
OIDC_CLIENT_ID=core-studio-local
OIDC_CLIENT_SECRET=
# Tenant ID that sign-ins must come from (local: any fixed UUID used in test sign-ins)
OIDC_ALLOWED_TENANT_ID=
# Comma-separated Entra object IDs granted company-admin on sign-in
BOOTSTRAP_PLATFORM_ADMIN_OBJECT_IDS=
# Local key-encryption key for LLM credentials (32 bytes, base64). Development only; Azure uses Key Vault.
LOCAL_KEK=

# Hosts exempt from the production private-address block for LLM endpoints (comma-separated, exact host names).
LLM_ENDPOINT_ALLOWED_PRIVATE_HOSTS=
